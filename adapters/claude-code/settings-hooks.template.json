{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "node \"{{INSTALL_DIR}}/adapters/common/hook-runner.mjs\" --agent claude",
            "timeout": 30
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"{{INSTALL_DIR}}/adapters/common/hook-runner.mjs\" --agent claude",
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^Bash$|^Edit$|^Write$|^MultiEdit$|^NotebookEdit$|^mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"{{INSTALL_DIR}}/adapters/common/hook-runner.mjs\" --agent claude",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^Bash$|^Edit$|^Write$|^MultiEdit$|^NotebookEdit$|^mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"{{INSTALL_DIR}}/adapters/common/hook-runner.mjs\" --agent claude",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"{{INSTALL_DIR}}/adapters/common/hook-runner.mjs\" --agent claude",
            "timeout": 30
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"{{INSTALL_DIR}}/adapters/common/hook-runner.mjs\" --agent claude",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
